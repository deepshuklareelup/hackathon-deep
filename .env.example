# Rofy Reel Agent — Environment Variables
# These are auto-loaded from rofy_2_llm/.env if you haven't set them here.
# Only add overrides or hackathon-specific keys below.

# Required for script generation
# ANTHROPIC_API_KEY=sk-ant-...

# Required for TTS narration
# OPENAI_API_KEY=sk-proj-...

# Required for image + video generation
# FAL_KEY=...

# Required for video upload (optional — video saves locally if not set)
# GCS_BUCKET_NAME=your-bucket-name
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp.json
